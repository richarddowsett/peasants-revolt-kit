rules_version = '2';

// ===============================================================
// Assumed Data Model & Access Architecture
// ===============================================================
//
// All database operations for `peasants-running-kit` (collections: `orders`,
// `event_tickets`, `events`, `products`, `feature_flags`) are performed
// exclusively by the backend API server via the Firebase Admin SDK, which
// authenticates using GCP IAM service account credentials and bypasses
// Firestore Security Rules.
//
// Direct client-side (Web SDK / REST API) read and write access is completely
// disabled across all collections and documents.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
